# ============================================================
#  Sample env file — copy it to .env and adjust the values
#  cp .env.example .env
# ============================================================

# development | production
# In production mode the default SECRET_KEY is not accepted
ENVIRONMENT=production

# JWT token signing key — a long random value (secrets.token_urlsafe(48))
SECRET_KEY=CHANGE_ME_please_use_a_long_random_value

# sqlite (dev/small) or PostgreSQL (production)
# sqlite:  sqlite+aiosqlite:///./exam.db
# postgres: postgresql+asyncpg://user:pass@host:5432/examdb
DATABASE_URL=sqlite+aiosqlite:///./exam.db

# ---- Payment gateway ----
# local | zarinpal_sandbox | zarinpal_live
PAYMENT_MODE=local
# Zarinpal merchant ID (36-char UUID) — from your Zarinpal panel
ZARINPAL_MERCHANT=
# Public backend URL used for returning from the gateway
PAYMENT_CALLBACK_BASE_URL=http://localhost:8000

# ---- Frontend ----
# Public frontend URL (for redirect on return from the gateway)
FRONTEND_URL=http://localhost:5173
# Allowed CORS origins (comma separated)
CORS_ORIGINS=http://localhost:5173

# ---- License (single-client activation) ----
# LICENSE_HASH = sha256 of the license key (never write the key itself in code/env).
# Generate it with:  ./.venv/Scripts/python.exe tools/make_license.py
# LICENSE_ENABLED=true for delivery; leave empty in development so the gate stays off.
# LICENSE_FILE is where the activation marker is stored (suggested OUTSIDE the source tree).
LICENSE_ENABLED=true
LICENSE_HASH=
LICENSE_FILE=data/license.dat

# ---- Request rate limit ----
# RATE_LIMIT_ENABLED=false in test/dev to avoid interference; true in production
RATE_LIMIT_ENABLED=true